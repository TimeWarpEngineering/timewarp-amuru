<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TimeWarp.Amuru</PackageId>
    <Description>Fluent API for elegant C# scripting with pipeline support</Description>
    <PackageTags>cli;scripting;fluent;shell;pipeline;amuru</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" />
    <PackageReference Include="TimeWarp.Ramani" />
    <PackageReference Include="TimeWarp.Terminal" />
  </ItemGroup>

  <!-- dev test compiles tests/timewarp-amuru/multi-file-runners/run-tests.cs (assembly run-tests).
       dotnet run of a session test file uses that file name as its assembly name.
       Each of those files includes the fake seam. Task 139.
       A direct InternalsVisibleTo from TimeWarp.Amuru.Tools stays absent. -->
  <ItemGroup>
    <InternalsVisibleTo Include="run-tests" />
    <InternalsVisibleTo Include="json-rpc-session-machine.send-async" />
    <InternalsVisibleTo Include="json-rpc-session-machine.send-async.guard" />
  </ItemGroup>

  <!-- Surface guard for this packable project only. PrivateAssets keeps it out of the nupkg.
       buildtransitive is required: the package ships its props/targets only under buildTransitive/. -->
  <ItemGroup Label="Public API analyzers">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <!-- Basenames are Roslyn-mandated and not kebab-case. The public-api folder is pruned
         from kebab-path-names; the analyzer matches these files by basename. -->
    <AdditionalFiles Include="public-api/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="public-api/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepositoryRoot)readme.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- AMURU0001-0003 (task 150). The analyzer ships in this package because Shell lives here.
       The ProjectReference orders the build and runs the analyzer on this project; the target
       packs the dll under analyzers/dotnet/cs so every consumer gets it. Same layout as
       timewarp-jaribu's timewarp-jaribu-analyzers. -->
  <ItemGroup Label="Shell builder analyzer">
    <ProjectReference
      Include="../timewarp-amuru-analyzers/timewarp-amuru-analyzers.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer" />
  </ItemGroup>

  <Target Name="PackAmuruAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)../timewarp-amuru-analyzers/timewarp-amuru-analyzers.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <None
        Include="$(MSBuildThisFileDirectory)../timewarp-amuru-analyzers/bin/$(Configuration)/netstandard2.0/timewarp-amuru-analyzers.dll"
        Pack="true"
        PackagePath="analyzers/dotnet/cs"
        Visible="false" />
    </ItemGroup>
  </Target>

</Project>
