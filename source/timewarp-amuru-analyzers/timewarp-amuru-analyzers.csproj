<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roslyn analyzer packed into TimeWarp.Amuru under analyzers/dotnet/cs (task 150).
       Not a package of its own: source/timewarp-amuru/timewarp-amuru.csproj builds it and
       packs the dll. Layout copied from timewarp-jaribu source/timewarp-jaribu-analyzers. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>TimeWarp.Amuru.Analyzers</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Compile-time checks that point raw Shell.Builder calls at the typed Amuru builders.</Description>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
