<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Git hooks are never packed">
    <!-- SDK 11 file-based apps restore as RID-specific AOT tool packages.
         Root GeneratePackageOnBuild then native-compiles on every hook run and
         fails: GeneratePackageOnBuild is not supported for native compilation.
         Hooks stay JIT. The product csprojs still pack. -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
