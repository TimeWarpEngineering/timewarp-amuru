{
  // Per-repo configuration for TimeWarp.Nuru.DevCli (check-version, dev release).
  //
  // TimeWarp.Amuru.Tools rides its own version and cadence (<Version> override in
  // source/timewarp-amuru-tools/timewarp-amuru-tools.csproj), so the props-version
  // publish-state gate covers the core package only. The release pipeline still
  // verifies and pushes every packable project at its own resolved version
  // (tools/dev-cli/endpoints/workflow-command.cs); --skip-duplicate makes an
  // unchanged Tools version a no-op on a core release.
  "checkVersionConfig": {
    "packages": "TimeWarp.Amuru"
  }
}
