<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Disable specific analyzer warnings for test projects -->
    <NoWarn>$(NoWarn);CA1812;CS1998;CS8652;CA2252;CA1707;CA1052;CA1515</NoWarn>
    <!-- CS8652: Feature 'extensions' is in Preview -->
    <!-- CA2252: Using preview features -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceDirectory)timewarp-amuru/timewarp-amuru.csproj" />
    <ProjectReference Include="$(SourceDirectory)timewarp-amuru-tools/timewarp-amuru-tools.csproj" />
    <PackageReference Include="TimeWarp.Jaribu" />
    <PackageReference Include="TimeWarp.Terminal" />
    <PackageReference Include="CliWrap" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared test helpers compiled into all test files -->
    <Compile Include="$(MSBuildThisFileDirectory)test-helpers.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)git-repository-fixture.cs" />
    <!-- The completion oracle is test-only. It is not a package reference: the core project
         already restores TimeWarp.Ramani, and the generator does not flow through that reference. -->
    <Compile Include="$(MSBuildThisFileDirectory)command-completion/*.cs" />
  </ItemGroup>

  <!-- The generator does not flow through the core ProjectReference. The package is already
       restored for source/timewarp-amuru. This is an analyzer item, not a PackageReference. -->
  <Target Name="AddCommandCompletionRamaniGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Include="$(NuGetPackageRoot)timewarp.ramani/1.0.0-beta.23/analyzers/dotnet/cs/TimeWarp.Ramani.Generators.dll" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Global usings for all test projects -->
    <Using Include="TimeWarp.Amuru.Testing" />
    <Using Include="TimeWarp.Amuru.Testing.TestHelpers" Static="true" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Reflection" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="Shouldly" />
    <Using Include="TimeWarp.Amuru" />
    <Using Include="TimeWarp.Amuru.Native.FileSystem" />
    <Using Include="TimeWarp.Amuru.Testing" />
    <Using Include="TimeWarp.Amuru.Native.Aliases.Bash" Static="true" />
    <Using Include="TimeWarp.Jaribu" />
    <Using Include="TimeWarp.Jaribu.TestRunner" Static="true" />
    <Using Include="TimeWarp.Terminal" />
  </ItemGroup>
</Project>
