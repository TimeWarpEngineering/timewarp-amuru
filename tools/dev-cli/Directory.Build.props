<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Suppress warnings that don't apply to CLI tools -->
    <!-- CA1031: Catch general exception types - OK for CLI error handling -->
    <!-- CA1034: Nested types - used by Nuru command pattern -->
    <!-- CA1303: Literal strings - OK for CLI output -->
    <!-- CA1508: Dead code analysis false positive -->
    <!-- CA1515: Internal types in exe projects are fine -->
    <!-- CA1849: Sync WriteLine is fine for CLI output -->
    <!-- CA2007: ConfigureAwait not needed in top-level console apps -->
    <!-- CA2016: CancellationToken forwarding - will address where needed -->
    <!-- CA2000: Dispose on app builder - handled by framework -->
    <!-- CA5399: HttpClient certificate revocation - DevCli NuGetVersionService -->
    <!-- RCS1046: Async suffix - private methods don't need it -->
    <!-- IDE0005, IDE0022, IDE0046, IDE0052, IDE0055, IDE0058, IDE0066, IDE0078, IDE0160,
         IDE0290: style rules violated by TimeWarp.Nuru.DevCli content files compiled
         from the NuGet cache, where repo .editorconfig cannot reach -->
    <!-- IDE0211: dev.cs is a file-based app (runfile) and requires top-level statements -->
    <!-- IL2026, IL3050: reflection-based JsonSerializer in TimeWarp.Nuru.DevCli content files -->
    <!-- IL2104: Assembly produced trim warnings - StreamJsonRpc transitive dep on Newtonsoft.Json -->
    <NoWarn>$(NoWarn);CA1031;CA1034;CA1303;CA1508;CA1515;CA1849;CA2007;CA2016;CA2000;CA5399;RCS1046;IDE0065;IDE0005;IDE0022;IDE0046;IDE0052;IDE0055;IDE0058;IDE0066;IDE0078;IDE0160;IDE0211;IDE0290;IL2026;IL2104;IL3050;IL3053</NoWarn>

    <!-- AOT Support - enable only during publish, not build -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Nuru interceptors for source-generated commands -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);TimeWarp.Nuru.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared DevCli endpoints/services (clean, check-version, release, self-install)
         compile from the TimeWarp.Nuru.DevCli package content under namespace DevCli -->
    <Using Include="DevCli" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include global usings, local endpoint and service files in compilation.
         clean, check-version, release and self-install come from TimeWarp.Nuru.DevCli. -->
    <Compile Include="global-usings.cs" />
    <Compile Include="endpoints/**/*.cs" />
    <Compile Include="services/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project references -->
    <ProjectReference Include="$(SourceDirectory)timewarp-amuru/timewarp-amuru.csproj" />
    <ProjectReference Include="$(SourceDirectory)timewarp-amuru-tools/timewarp-amuru-tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package references -->
    <PackageReference Include="TimeWarp.Nuru" />
    <PackageReference Include="TimeWarp.Nuru.DevCli" />
  </ItemGroup>

</Project>
