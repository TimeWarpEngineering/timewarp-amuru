<Project>
  <!--
    The shared DevCli clean command only calls IRepoCleanService.CleanAsync.
    This repo's clean command also removes the local nupkg feed, so the package
    copy must not compile beside tools/dev-cli/endpoints/clean-command.cs.
  -->
  <ItemGroup>
    <Compile Remove="$(NuGetPackageRoot)timewarp.nuru.devcli/**/content/any/endpoints/clean-command.cs" />
  </ItemGroup>

  <!--
    AMURU0001 in TimeWarp.Nuru.DevCli content (task 150, gh files task 152). These package files
    are compiled here from the NuGet cache, where no repo .editorconfig or pragma can reach them:
      services/packable-project-service.cs   Shell.Builder("dotnet") with "msbuild" (task 150)
      services/github-packages-credential.cs Shell.Builder("gh") with "auth token" (task 152)
      endpoints/release-command.cs           Shell.Builder("gh") with "auth status" (task 152)
      endpoints/release-command.guards.cs    Shell.Builder("gh") with "run list" and "api" (task 152)
    The fix belongs in timewarp-nuru: move those calls to DotNet.MsBuild() and the Gh builders
    once an Amuru release carries them. Until then a generated global analyzer config lowers
    AMURU0001 to suggestion for those package files only. Repo files keep the error.
    Drop a file from _DevCliRawShellFiles when the DevCli package no longer has a raw call there,
    and remove this target when the list is empty.
  -->
  <Target Name="ScopeAmuruAnalyzerForDevCliContent" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_DevCliRawShellFiles>;packable-project-service;github-packages-credential;release-command;release-command.guards;</_DevCliRawShellFiles>
    </PropertyGroup>
    <ItemGroup>
      <_DevCliRawShellContent
        Include="@(Compile->'%(FullPath)')"
        Condition="$(_DevCliRawShellFiles.Contains(';%(Filename);')) And $([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/timewarp.nuru.devcli/'))" />
    </ItemGroup>
    <PropertyGroup>
      <_DevCliAmuruGlobalConfig>$(IntermediateOutputPath)amuru-devcli-content.globalconfig</_DevCliAmuruGlobalConfig>
    </PropertyGroup>
    <WriteLinesToFile
      Condition="'@(_DevCliRawShellContent)' != ''"
      File="$(_DevCliAmuruGlobalConfig)"
      Lines="is_global = true;@(_DevCliRawShellContent->'[%(Identity)]%0Adotnet_diagnostic.AMURU0001.severity = suggestion')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup Condition="'@(_DevCliRawShellContent)' != ''">
      <EditorConfigFiles Include="$(_DevCliAmuruGlobalConfig)" />
    </ItemGroup>
  </Target>
</Project>
